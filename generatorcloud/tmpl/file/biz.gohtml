// Save converts a non-nil save DTO and inserts it using model defaults, returning its ID.
func (v *{{.StructName}}BizService) Save(save *model.{{.StructName}}SDTO) ({{.IDType}}, error) {
    if save == nil {
        return 0, webcloud.ErrBadRequestParameters
    }
    entity, err := save.ToT()
    if err != nil {
        return 0, err
    }
    if _, err = v.repo.Save(entity); err != nil {
        return 0, err
    }
    return entity.ID, nil
}

// SaveWithoutZeroFields converts a non-nil save DTO and inserts nonzero fields, returning its ID.
func (v *{{.StructName}}BizService) SaveWithoutZeroFields(save *model.{{.StructName}}SDTO) ({{.IDType}}, error) {
    if save == nil {
