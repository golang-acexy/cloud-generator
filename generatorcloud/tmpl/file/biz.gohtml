// QueryByIDs queries IDs; empty input returns an empty DTO slice and input ordering is not guaranteed.
func (v *{{.StructName}}BizService) QueryByIDs(ids []{{.IDType}}) ([]*model.{{.StructName}}DTO, error) {
    if len(ids) == 0 {
        return make([]*model.{{.StructName}}DTO, 0), nil
    }
    queryIDs := make([]any, len(ids))
    for index, id := range ids {
        queryIDs[index] = id
    }
    entities, err := v.repo.QueryByIDs(queryIDs)
    if err != nil {
        return nil, err
    }
    return model.{{.StructName}}Slice(entities).ToDTOs()
}

