// QueryPage converts typed conditions and validates time ranges; no HTTP page-size cap is applied here.
func (v *{{.StructName}}BizService) QueryPage(pager webcloud.PagerDTO[model.{{.StructName}}QDTO]) (webcloud.Pager[model.{{.StructName}}DTO], error) {
    condition, err := pager.Condition.ToT()
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    ranges, err := webcloud.ConvertTimeRanges(pager.TimeRanges, v.AllowedTimeRangeFields(), v.DefaultTimeRangeField())
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    page, err := v.repo.QueryPageByCond(
        rds.NewPageQuery(*condition, pager.Number, pager.Size).
            OrderBy(v.DefaultOrderBy()).
            WithTimeRanges(ranges...),
    )
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    records, err := model.{{.StructName}}Slice(page.Records).ToDTOs()
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    return webcloud.Pager[model.{{.StructName}}DTO]{
        Records: records,
        Total:   page.Total,
        Number:  page.Number,
        Size:    page.Size,
    }, nil
}

