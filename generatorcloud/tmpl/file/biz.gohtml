// ModifyByCond updates nonzero typed predicates and assignments; nil update DTOs are rejected.
func (v *{{.StructName}}BizService) ModifyByCond(condition model.{{.StructName}}QDTO, updated *model.{{.StructName}}MDTO) (int64, error) {
    if updated == nil {
        return 0, webcloud.ErrBadRequestParameters
    }
    conditionEntity, err := condition.ToT()
    if err != nil {
        return 0, err
    }
    updatedEntity, err := updated.ToT()
    if err != nil {
        return 0, err
    }
    return v.repo.ModifyByCond(updatedEntity, *conditionEntity)
}

