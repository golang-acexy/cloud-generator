// QueryOneByCond queries nonzero typed conditions and returns nil, nil for no record.
func (v *{{.StructName}}BizService) QueryOneByCond(condition model.{{.StructName}}QDTO) (*model.{{.StructName}}DTO, error) {
    entityCondition, err := condition.ToT()
