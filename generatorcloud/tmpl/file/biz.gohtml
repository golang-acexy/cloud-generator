func (v *{{.StructName}}BizService) BaseQuery(condition map[string]any) ([]*model.{{.StructName}}DTO, error) {
    entities := make([]*model.{{.StructName}}, 0)
    db := v.repo.TableGormDB()
    err := db.Where(condition).Order(v.DefaultOrderBy()).Limit(v.MaxQuerySize()).Scan(&entities).Error
    if err != nil {
        return nil, err
    }
    return model.{{.StructName}}Slice(entities).ToDTOs()
}

func (v *{{.StructName}}BizService) BaseQueryPage(condition map[string]any, timeRanges []webcloud.TimeRange, pager *webcloud.Pager[model.{{.StructName}}DTO]) error {
    ranges, err := v.convertTimeRanges(timeRanges)
    if err != nil {
        return err
    }
    page := databasecloud.Pager[model.{{.StructName}}]{
        Number: pager.Number,
        Size:   pager.Size,
    }
    query := rds.PageQuery{
        OrderBySQL: v.DefaultOrderBy(),
        TimeRanges: ranges,
    }
    if len(condition) == 0 {
        err = v.repo.QueryPageByCond(model.{{.StructName}}{}, query, &page)
    } else {
        err = v.repo.QueryPageByMap(condition, query, &page)
    }
    if err != nil {
        return err
    }
    records, err := model.{{.StructName}}Slice(page.Records).ToDTOs()
    if err != nil {
        return err
    }
    pager.Records = records
    pager.Total = page.Total
    return nil
}

