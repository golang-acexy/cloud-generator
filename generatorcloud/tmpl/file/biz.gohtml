}

// SaveBatch inserts converted DTOs; empty input returns an empty ID slice and nil elements are rejected.
func (v *{{.StructName}}BizService) SaveBatch(saves []*model.{{.StructName}}SDTO) ([]{{.IDType}}, error) {
    if len(saves) == 0 {
        return make([]{{.IDType}}, 0), nil
    }
    entities := make([]*model.{{.StructName}}, 0, len(saves))
    for _, save := range saves {
        if save == nil {
            return nil, webcloud.ErrBadRequestParameters
        }
        entity, err := save.ToT()
        if err != nil {
            return nil, err
        }
        entities = append(entities, entity)
    }
    if _, err := v.repo.SaveBatch(entities); err != nil {
        return nil, err
    }
    ids := make([]{{.IDType}}, len(entities))
    for index, entity := range entities {
        ids[index] = entity.ID
    }
    return ids, nil
}

// BaseQueryByID queries column predicates; no result returns nil, nil and errors are preserved.
func (v *{{.StructName}}BizService) BaseQueryByID(condition map[string]any) (*model.{{.StructName}}DTO, error) {
    entity, err := v.repo.QueryOneByMap(rds.NewMapQuery(condition))
    if err != nil || entity == nil {
        return nil, err
    }
    return entity.ToDTO()
}

// BaseQueryOne queries column predicates with default ordering; no result returns nil, nil.
func (v *{{.StructName}}BizService) BaseQueryOne(condition map[string]any) (*model.{{.StructName}}DTO, error) {
    entity, err := v.repo.QueryOneByMap(
        rds.NewMapQuery(condition).OrderBy(v.DefaultOrderBy()),
    )
    if err != nil || entity == nil {
        return nil, err
    }
    return entity.ToDTO()
}

// BaseQuery queries column predicates with default ordering and the list limit; empty filters are accepted.
func (v *{{.StructName}}BizService) BaseQuery(condition map[string]any) ([]*model.{{.StructName}}DTO, error) {
    entities, err := v.repo.QueryByMap(
        rds.NewMapQuery(condition).
            OrderBy(v.DefaultOrderBy()).
            WithLimit(v.MaxQuerySize()),
    )
    if err != nil {
        return nil, err
    }
    return model.{{.StructName}}Slice(entities).ToDTOs()
}

// BaseQueryPage validates time ranges and queries a page; request size is not capped by MaxQuerySize.
func (v *{{.StructName}}BizService) BaseQueryPage(query webcloud.PagerDTO[map[string]any]) (webcloud.Pager[model.{{.StructName}}DTO], error) {
    ranges, err := webcloud.ConvertTimeRanges(query.TimeRanges, v.AllowedTimeRangeFields(), v.DefaultTimeRangeField())
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    page, err := v.repo.QueryPageByMap(
        rds.NewMapPageQuery(query.Condition, query.Number, query.Size).
            OrderBy(v.DefaultOrderBy()).
            WithTimeRanges(ranges...),
    )
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    records, err := model.{{.StructName}}Slice(page.Records).ToDTOs()
    if err != nil {
        return webcloud.Pager[model.{{.StructName}}DTO]{}, err
    }
    return webcloud.Pager[model.{{.StructName}}DTO]{Records: records, Total: page.Total, Number: page.Number, Size: page.Size}, nil
}

