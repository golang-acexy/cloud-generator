func (v *{{.StructName}}BizService) SaveBatch(saves []*model.{{.StructName}}SDTO) ([]{{.IDType}}, error) {
    if len(saves) == 0 {
        return make([]{{.IDType}}, 0), nil
    }
    entities := make([]*model.{{.StructName}}, 0, len(saves))
    for _, save := range saves {
        if save == nil {
            return nil, webcloud.ErrBadRequestParameters
        }
        entity, err := save.ToT()
        if err != nil {
            return nil, err
        }
        entities = append(entities, entity)
    }
    if _, err := v.repo.SaveBatch(entities); err != nil {
        return nil, err
    }
    ids := make([]{{.IDType}}, len(entities))
    for index, entity := range entities {
        ids[index] = entity.ID
    }
    return ids, nil
}

