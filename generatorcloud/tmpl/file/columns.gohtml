
// {{.StructName}}Columns holds typed column descriptors for the model.
type {{.StructName}}Columns struct {
{{- range .Fields }}
	// {{.Name}} selects the corresponding model field.
	{{.Name}} gormstarter.Column[{{$.StructName}}, {{.Type}}]
{{- end }}
}

var {{.ParamName}}Columns = {{.StructName}}Columns{
{{- range .Fields }}
	{{.Name}}: gormstarter.NewColumn(func(entity *{{$.StructName}}) *{{.Type}} { return &entity.{{.Name}} }),
{{- end }}
}

// {{.StructName}}ColumnSet returns shared column descriptors; do not mutate the returned object.
func {{.StructName}}ColumnSet() *{{.StructName}}Columns {
	return &{{.ParamName}}Columns
}
