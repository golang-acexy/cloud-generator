
// {{.ModelStructName}}SDTO contains configured save fields, excluding database-generated fields.
type {{.ModelStructName}}SDTO struct {
{{- range .Fields }}
    {{- if not (call $.IsSExcluded .Name) }}
    // {{.Name}} carries the corresponding model field value.
    {{.Name}} {{.Type}} `{{.Tags}}`
    {{- end }}
{{- end }}
}

// {{.ModelStructName}}MDTO contains configured update fields, excluding database-generated fields.
type {{.ModelStructName}}MDTO struct {
{{- range .Fields }}
    {{- if not (call $.IsMExcluded .Name) }}
    // {{.Name}} carries the corresponding model field value.
    {{.Name}} {{.Type}} `{{.Tags}}`
    {{- end }}
{{- end }}
}

// {{.ModelStructName}}QDTO contains typed query fields; GORM struct conditions omit zero values.
type {{.ModelStructName}}QDTO struct {
{{- range .Fields }}
    {{- if not (call $.IsQExcluded .Name) }}
    // {{.Name}} carries the corresponding model field value.
    {{.Name}} {{.Type}} `{{.Tags}}`
    {{- end }}
{{- end }}
}

// {{.ModelStructName}}DTO contains configured response fields; exclusions do not enforce runtime authorization.
type {{.ModelStructName}}DTO struct {
{{- range .Fields }}
    {{- if not (call $.IsDExcluded .Name) }}
    // {{.Name}} carries the corresponding model field value.
    {{.Name}} {{.Type}} `{{.Tags}}`
    {{- end }}
{{- end }}
}

// ToDTO allocates a response DTO and returns copy errors.
func (v {{.ModelStructName}}) ToDTO() (*{{.ModelStructName}}DTO, error) {
    var dto {{.ModelStructName}}DTO
    if err := copier.Copy(&dto, v); err != nil {
        return nil, err
    }
    return &dto, nil
}

// ParseDTO copies into a caller-owned non-nil DTO; errors may leave partial output.
func (v {{.ModelStructName}}) ParseDTO(dto *{{.ModelStructName}}DTO) error {
    return copier.Copy(dto, v)
}

// {{.ModelStructName}}Slice provides DTO conversion for a model slice.
type {{.ModelStructName}}Slice []*{{.ModelStructName}}

// ToDTOs allocates response DTOs and returns copy errors; referenced values follow copier semantics.
func (v {{.ModelStructName}}Slice) ToDTOs() ([]*{{.ModelStructName}}DTO, error) {
    dtos := make([]*{{.ModelStructName}}DTO, 0, len(v))
    if err := copier.Copy(&dtos, v); err != nil {
        return nil, err
    }
    return dtos, nil
}

// ParseDTOs copies into a caller-owned slice destination; errors may leave partial output.
func (v {{.ModelStructName}}Slice) ParseDTOs(dtos *[]*{{.ModelStructName}}DTO) error {
    return copier.Copy(dtos, v)
}

