package {{.PKG}}

import (
	"github.com/golang-acexy/cloud-database/databasecloud/rds"
	"github.com/golang-acexy/starter-gorm/gormstarter"
	"gorm.io/gorm"
{{- if .Pkg }}
	"{{ .Pkg }}"
{{- end }}
)

// {{.StructName}}Mapper adds concrete transaction copying and typed columns to BaseMapper.
type {{.StructName}}Mapper struct {
	// BaseMapper supplies starter-managed database operations.
	gormstarter.BaseMapper[model.{{.StructName}}]
}

// Columns returns shared column descriptors; callers must treat them as read-only.
func ({{.StructName}}Mapper) Columns() *model.{{.StructName}}Columns {
	return model.{{.StructName}}ColumnSet()
}

// WithTxMapper returns a mapper copy bound to a caller-owned transaction; nil restores ordinary routing.
func (m {{.StructName}}Mapper) WithTxMapper(tx *gorm.DB) {{.StructName}}Mapper {
	return {{.StructName}}Mapper{
		BaseMapper: m.GetBaseMapperWithTx(tx),
	}
}

// {{.StructName}}Repo preserves its concrete type when binding transactions.
type {{.StructName}}Repo struct {
	// Repository supplies CRUD operations and concrete transaction factories.
	rds.Repository[{{.StructName}}Repo, {{.StructName}}Mapper, model.{{.StructName}}]
}

// Columns returns shared column descriptors; callers must treat them as read-only.
func (r {{.StructName}}Repo) Columns() *model.{{.StructName}}Columns {
	return r.RawMapper().Columns()
}

var {{.ParamName}}Repo = new{{.StructName}}Repo()

func new{{.StructName}}Repo() {{.StructName}}Repo {
	repository := rds.NewRepository(
		{{.StructName}}Mapper{},
		func(repository rds.Repository[{{.StructName}}Repo, {{.StructName}}Mapper, model.{{.StructName}}]) {{.StructName}}Repo {
			return {{.StructName}}Repo{Repository: repository}
		},
	)
	return {{.StructName}}Repo{Repository: repository}
}

// New{{.StructName}}Repo returns a value copy of the shared base repository; custom state must be preserved by transaction factories.
func New{{.StructName}}Repo() {{.StructName}}Repo {
	return {{.ParamName}}Repo
}
